---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GatewayCanvas from "../components/GatewayCanvas.astro";
import VetBadge from "../components/VetBadge.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import { capabilityStatementHref } from "../data/company.ts";

const standards = [
  "NIST AI RMF", "OWASP LLM Top 10", "MITRE ATLAS", "NIST 800-207",
  "CIS Benchmarks", "DISA STIG", "ISO 42001", "SOC 2",
];

// The two pillars — the compliant environment, and the governed AI inside it.
const pillars = [
  {
    tag: "Managed environment",
    title: "CMMC-ready GCC High enclaves",
    body: "We stand up your Microsoft 365 GCC High tenant, migrate your people and data into it, engineer the NIST 800-171 controls, and run it for you — so you stay eligible to win and keep DoD work that touches CUI or ITAR-controlled data.",
    points: ["Design, build & migration", "NIST 800-171 / CMMC L2 alignment", "Fully managed operations", "GCC High G5 licensing"],
    href: "/gcc-high",
    cta: "Managed GCC High →",
  },
  {
    tag: "Governed intelligence",
    title: "AI you can actually use on the mission",
    body: "Most GCC High shops stop at email and files. We stand up governed access to the frontier models authorized for your sovereign cloud — one gateway, fail-closed guardrails, a defensible audit trail — plus assessment and red-teaming of the AI you deploy.",
    points: ["Governed AI gateway", "Adversarial AI red-teaming", "AI security assessments", "Secure-adoption advisory"],
    href: "/nineline",
    cta: "See what we build, running →",
  },
];

// Managed GCC High — the four bands of the managed service.
// Advisory-led services — the four engagements Optimal runs, arced
// find it → prove it → build the controls → keep the program governed.
// Each carries concrete scope and a named deliverable, not benefit copy.
// Standard security-assessment methodology, written to AI systems.
const phases = [
  {
    idx: "01",
    n: "Scope",
    d: "We define the systems in play, the data they touch, the threat model that actually matters to you, and the rules of engagement. The scope is written to your stack — not lifted from a template.",
  },
  {
    idx: "02",
    n: "Map the attack surface",
    d: "We inventory every way in and out: models, prompts, retrieval sources, tools and functions, identities, credentials, and egress paths. You can't secure what hasn't been mapped.",
  },
  {
    idx: "03",
    n: "Test like an adversary",
    d: "We run the OWASP LLM Top 10 and MITRE ATLAS techniques against your systems — injection, extraction, manipulation, abuse-case chains — and document what works, with evidence.",
  },
  {
    idx: "04",
    n: "Report for two audiences",
    d: "Ranked findings, reproduction steps, business impact, and specific remediation — written for the engineers who fix it and the leaders who own the risk.",
  },
  {
    idx: "05",
    n: "Remediate & retest",
    d: "We help close the findings, then prove they're closed. The engagement ends with evidence, not a backlog of open items.",
  },
];

// OWASP Top 10 for LLM Applications (2025) — the threat taxonomy we test to.
const owasp = [
  ["LLM01", "Prompt Injection"],
  ["LLM02", "Sensitive Information Disclosure"],
  ["LLM03", "Supply Chain"],
  ["LLM04", "Data & Model Poisoning"],
  ["LLM05", "Improper Output Handling"],
  ["LLM06", "Excessive Agency"],
  ["LLM07", "System Prompt Leakage"],
  ["LLM08", "Vector & Embedding Weaknesses"],
  ["LLM09", "Misinformation"],
  ["LLM10", "Unbounded Consumption"],
];

const flow = [
  {
    idx: "01",
    n: "Authorize",
    stack: "Cloudflare Access · Okta OIDC",
    d: "Authenticate the caller, then check the request against a model and resource allowlist. No token is issued for a model you haven't approved.",
  },
  {
    idx: "02",
    n: "Guard",
    stack: "NeMo Guardrails · PII/secret detectors",
    d: "Inline detection on prompt and response — injection, jailbreak, PII/DLP, secret exfiltration — fail-closed and pre-call. A blocked request never reaches the provider.",
  },
  {
    idx: "03",
    n: "Forward",
    stack: "LiteLLM keys · Squid egress",
    d: "Proxy to the approved model — commercial, GovCloud, or self-hosted — through per-key virtual credentials, with egress pinned to a default-deny allowlist.",
  },
  {
    idx: "04",
    n: "Prove",
    stack: "Structured JSON · Postgres",
    d: "Write a structured audit row joined by request ID — the artifact your reviewers read directly, on your retention, in your account.",
  },
];

// OWASP Top 10 for LLM Applications (2025) — the threat taxonomy we test to.
const faqs = [
  {
    q: "What does Optimal do?",
    a: "Optimal does two things that work together. First, we build, migrate, and manage CMMC-ready Microsoft 365 GCC High enclaves for the defense industrial base — the sovereign environment you need to handle CUI and ITAR-controlled data on DoD contracts. Second, we stand up the governed AI that runs safely inside those environments, and assess and red-team the AI systems teams deploy. We're an SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB).",
  },
  {
    q: "What is Microsoft 365 GCC High, and do I need it?",
    a: "GCC High is a US-sovereign version of Microsoft 365, physically and logically isolated, with US data residency and screened US-person support. If you're a defense contractor handling Controlled Unclassified Information (CUI) or ITAR/export-controlled data, GCC High is the environment built to support the DFARS 252.204-7012 and CMMC Level 2 obligations in your contracts. Optimal stands the enclave up and runs it for you.",
  },
  {
    q: "Does moving to GCC High make me CMMC compliant?",
    a: "No environment makes you compliant on its own — CMMC Level 2 is a third-party assessment against the 110 NIST SP 800-171 controls. What GCC High gives you is a foundation built for those controls. Optimal implements and documents the control set inside your enclave (SSP and POA&M), collects the evidence, and gets you assessment-ready. The certified assessment itself is performed independently by an accredited C3PAO — we prepare the environment, we don't grade it.",
  },
  {
    q: "Is Optimal a product company or a services firm?",
    a: "Advisory-led. We deliver engagements, not a SaaS subscription. The control pattern we implement is published as an open-source Zero Trust reference architecture — so you can read exactly what we build before we build it, and keep operating it yourself afterward.",
  },
  {
    q: "We already have Azure, AWS, or GCP — can you work in our cloud?",
    a: "Yes, and it's often the fastest path. We build governed, audited access to the frontier models already available in the cloud you license — Azure OpenAI Service, Amazon Bedrock, and Google Vertex AI — so your teams reach them safely without a new vendor or procurement. It's available to enterprises and to all of SLED (state, local, and education), as well as federal teams.",
  },
  {
    q: "Can Optimal work with federal, SLED, and enterprise teams?",
    a: "Yes. Optimal is an SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB), eligible for SDVOSB and VOSB set-aside contracts, and works with federal agencies, SLED (state, local, and education) entities, and enterprises. We deliver across GovCloud, commercial cloud (Azure, AWS, GCP), on-prem, and fully air-gapped networks.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title="Optimal — Managed GCC High enclaves & governed AI for the defense industrial base"
  description="Optimal builds, migrates, and manages CMMC-ready Microsoft 365 GCC High enclaves for the defense industrial base — and stands up the governed AI that runs safely inside them. Aligned to DFARS 252.204-7012, NIST SP 800-171, and CMMC Level 2, with support for CUI and ITAR-controlled data. An SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB)."
  jsonLd={[faqSchema]}
>
  <Header />

  <!-- HERO -->
  <section class="hero relative">
    <div class="glow"></div>
    <GatewayCanvas variant="hero" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container z">
      <span class="eyebrow">Managed GCC High · Governed AI · SDVOSB</span>
      <h1 class="display">Your GCC&nbsp;High enclave.<br /><span class="grad">Built, managed, CMMC-ready.</span></h1>
      <p class="lead">
        Optimal builds, migrates, and runs Microsoft&nbsp;365 GCC&nbsp;High for defense
        contractors — and stands up the governed AI that works safely inside it.
        One veteran-owned partner for the enclave and the intelligence on top of it.
      </p>
      <div class="cta-row">
        <a href="/contact" class="btn btn-primary">Book a scoping call →</a>
        <a href="/gcc-high" class="btn btn-ghost">Explore managed GCC High</a>
      </div>
      <p class="cta-aside muted">
        Not sure yet? <a href="/do-i-need-gcc-high">Do I actually need GCC High? Get the 2-minute answer →</a>
      </p>
      <div class="hero-meta muted">
        <span>Sovereign by default</span><span class="dot">•</span>
        <span>CUI &amp; ITAR-ready</span><span class="dot">•</span>
        <span>SDVOSB-certified</span>
      </div>
    </div>
  </section>

  <!-- STANDARDS WALL + VET STRIP -->
  <section id="standards" class="section--tight standards">
    <div class="container">
      <p class="wall-label muted">Engineered and measured to the standards that gate production AI</p>
      <div class="wall">
        {standards.map((s) => <span class="chip">{s}</span>)}
      </div>
      <div class="vet-strip">
        <VetBadge size={84} />
        <div class="vet-copy">
          <p class="vet-note muted">
            Optimal, LLC is a <strong>Service-Disabled Veteran-Owned Small Business</strong> —
            SBA-certified and eligible for veteran set-aside contracts. CAGE 14HQ0 · UEI TYMSGKDF2K48.
          </p>
          <a href={capabilityStatementHref} class="usecase-link">Download capability statement →</a>
        </div>
      </div>
      <!-- Proof of work: no customer logos yet, so the evidence is the work itself. -->
      <div class="proof-row">
        <a class="proof" href="https://github.com/optimal-cyber/AI-Gateway">
          <span class="proof-k">Open reference architecture</span>
          <span class="proof-v muted">The Zero Trust AI gateway, public on GitHub ↗</span>
        </a>
        <a class="proof" href="/whitepapers/securing-agentic-ai/">
          <span class="proof-k">Published whitepaper</span>
          <span class="proof-v muted">Securing Agentic AI — threat model to control crosswalk</span>
        </a>
        <a class="proof" href="/blog">
          <span class="proof-k">Field notes</span>
          <span class="proof-v muted">How we think about ATOs, boundaries, and agents</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PILLARS — what Optimal does, at a glance -->
  <section id="pillars" class="section pillars relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">What we do</span>
        <h2 class="h2">Two things, built to work together.</h2>
        <p class="lead" style="margin-top:14px;">Optimal gives the defense industrial base a compliant place to operate — and the governed AI to operate faster inside it. The sovereign cloud and the intelligence on top of it, from one veteran-owned partner.</p>
      </div>
      <div class="pillar-grid">
        {pillars.map((p) => (
          <article class="card pillar">
            <span class="tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <p class="muted pillar-body">{p.body}</p>
            <ul class="pillar-points">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a href={p.href} class="usecase-link">{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE / HOW IT WORKS -->
  <section id="how" class="section how relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">04 / Architecture</span>
        <h2 class="h2">Agents in. Approved resources out.<br />Everything in between, governed.</h2>
        <p class="lead" style="margin-top:14px;">The reference pattern behind our Governed AI Engineering work — the same open-source Zero Trust design we stand up in your environment. <a class="inline-link" href="https://github.com/optimal-cyber/AI-Gateway">Read the architecture ↗</a></p>
      </div>
      <ArchitectureDiagram steps={flow} />
      <p class="muted note">No wrapper, no SDK rewrite — point your existing OpenAI- or Anthropic-compatible client at the gateway and every call is governed and logged.</p>
    </div>
  </section>

            <!-- METHODOLOGY / PROCESS -->
  <section id="process" class="section process relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">03 / Process</span>
        <h2 class="h2">How an engagement runs.</h2>
        <p class="lead" style="margin-top:14px;">A working method, not a black box. You see the attack surface as we map it, the findings as we prove them, and the fixes as they close.</p>
      </div>
      <ol class="timeline">
        {phases.map((p) => (
          <li class="phase">
            <div class="phase-node"><span>{p.idx}</span></div>
            <div class="phase-body">
              <h4>{p.n}</h4>
              <p class="muted">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

        <!-- FAQ -->
  <section id="faq" class="section faq relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">06 / FAQ</span>
        <h2 class="h2">Questions we get first.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="faq-q">{f.q}</span>
              <span class="faq-mark" aria-hidden="true"></span>
            </summary>
            <p class="muted faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

    <!-- CTA -->
  <section class="section cta relative">
    <div class="glow"></div>
    <GatewayCanvas variant="ambient" align="center" density={0.7} />
    <div class="container z cta-inner">
      <h2 class="display" style="font-size:clamp(2rem,5vw,3.4rem);">Let&rsquo;s scope<br />the work.</h2>
      <p class="lead" style="margin:18px auto 0;">Tell us the contracts you&rsquo;re chasing and where you are today. We&rsquo;ll scope the engagement — a managed GCC&nbsp;High enclave, CMMC readiness, or the governed AI inside it. Calls are run by the founder.</p>
      <a href="/contact" class="btn btn-primary" style="margin-top:28px;">Book a scoping call →</a>
    </div>
  </section>

  <Footer />

</Layout>

<style>
  /* Keeps hero copy legible over the brightest part of the constellation. */
  .hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgba(8,9,13,0.92) 0%, rgba(8,9,13,0.66) 52%, rgba(8,9,13,0) 82%);
  }
  .proof-row { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--rule); display: grid; gap: 18px; }
  .proof { display: grid; gap: 4px; text-decoration: none; }
  .proof-k { font-size: 14px; font-weight: 600; color: var(--text); }
  .proof:hover .proof-k { color: var(--sunset); }
  .proof-v { font-size: 12.5px; }
  @media (min-width: 820px) { .proof-row { grid-template-columns: 1fr 1fr 1fr; gap: 32px; } }

  /* Shared editorial section-index kicker */
  .ix {
    display: inline-block; font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint);
    margin-bottom: 16px;
  }
  .sec-head.wide { max-width: 62ch; }
  .inline-link { color: var(--sunset); font-weight: 600; }
  .inline-link:hover { color: var(--ember); }

  /* PILLARS */
  .pillars { background: var(--bg); }
  .pillar-grid { display: grid; gap: 20px; margin-top: 42px; }
  @media (min-width: 820px) { .pillar-grid { grid-template-columns: repeat(2, 1fr); } }
  .pillar { display: flex; flex-direction: column; }
  .pillar h3 { font-size: 1.4rem; margin: 14px 0 12px; }
  .pillar-body { font-size: 14.5px; line-height: 1.7; }
  .pillar-points {
    list-style: none; margin: 20px 0 0; padding: 18px 0 0;
    border-top: 1px solid var(--rule);
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px 18px;
  }
  .pillar-points li {
    position: relative; padding-left: 18px; font-size: 13px; color: var(--text-dim); line-height: 1.45;
  }
  .pillar-points li::before {
    content: ""; position: absolute; left: 2px; top: 7px; width: 5px; height: 5px;
    border-radius: 1px; background: var(--sunset); transform: rotate(45deg); opacity: 0.85;
  }
  .pillar .usecase-link { margin-top: 22px; }

  /* MANAGED GCC HIGH */
  .gcc { background: var(--surface); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .gcc-flow { list-style: none; margin: 44px 0 0; padding: 0; display: grid; gap: 22px; }
  @media (min-width: 720px) { .gcc-flow { grid-template-columns: repeat(2, 1fr); gap: 30px 44px; } }
  .gcc-step { display: grid; grid-template-columns: 40px 1fr; gap: 16px; align-items: start; }
  .gcc-ix {
    font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--sunset);
    border: 1px solid var(--rule-strong); border-radius: 8px; width: 40px; height: 40px;
    display: grid; place-items: center;
  }
  .gcc-step h4 { font-size: 1.1rem; margin-bottom: 6px; }
  .gcc-step p { font-size: 14px; line-height: 1.65; max-width: 52ch; }

  /* HERO */
  .hero { padding: clamp(72px, 12vw, 150px) 0 clamp(48px, 7vw, 90px); }
  .hero .eyebrow { margin-bottom: 22px; }
  .hero h1 { margin-bottom: 24px; }
  .hero .lead { font-size: clamp(17px, 2.2vw, 21px); }
  .hero-caps {
    margin-top: 22px; font-family: var(--font-mono); font-size: 12.5px;
    letter-spacing: 0.06em; color: var(--text-dim); text-transform: uppercase;
  }
  .hero-caps span { color: var(--text-faint); margin: 0 4px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 30px; font-size: 13px; }
  .cta-aside { margin-top: 18px; font-size: 13.5px; }
  .cta-aside a { color: var(--sunset); font-weight: 600; }
  .cta-aside a:hover { color: var(--ember); }
  .hero-meta .dot { opacity: 0.4; }

  /* STANDARDS WALL */
  .standards { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--surface); }
  .wall-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.16em; text-align: center; margin-bottom: 22px; }
  .wall { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .chip {
    font-family: var(--font-mono); font-weight: 500; font-size: 12.5px; letter-spacing: 0.02em;
    color: var(--text-dim); border: 1px solid var(--rule); border-radius: 7px;
    padding: 7px 13px; transition: color .2s, border-color .2s;
  }
  .chip:hover { color: var(--text); border-color: var(--rule-strong); }
  .vet-strip {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 14px 18px; margin-top: 30px; padding-top: 26px;
    border-top: 1px solid var(--rule);
  }
  .vet-copy { display: grid; gap: 10px; justify-items: center; }
  .vet-note { font-size: 13px; max-width: 52ch; text-align: center; }
  .vet-note strong { color: var(--text); font-weight: 600; }

  /* APPROACH — asymmetric two-column */
  .sec-split { display: grid; gap: 26px; }
  .approach-body { display: grid; gap: 18px; max-width: 64ch; }
  .approach-body p { color: var(--text-dim); font-size: clamp(15px, 1.8vw, 17px); line-height: 1.75; }
  @media (min-width: 900px) {
    .sec-split { grid-template-columns: 0.85fr 1.15fr; gap: 56px; align-items: start; }
  }

  /* SERVICES */
  .svc-grid { display: grid; gap: 20px; margin-top: 42px; }
  @media (min-width: 800px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  .svc { display: flex; flex-direction: column; }
  .svc-top { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; }
  .svc-dur {
    display: block; margin-bottom: 12px; font-family: var(--font-mono);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint);
  }
  .svc-ix { font-family: var(--font-mono); font-size: 13px; font-weight: 600; letter-spacing: 0.05em; }
  .svc h3 { font-size: 1.3rem; }
  .svc-lede { font-size: 14.5px; line-height: 1.7; }
  .svc-scope {
    margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--rule);
  }
  .scope-label {
    display: block; font-family: var(--font-mono); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 10px;
  }
  .svc-scope ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .svc-scope li {
    position: relative; padding-left: 18px; font-size: 13.5px; color: var(--text-dim); line-height: 1.5;
  }
  .svc-scope li::before {
    content: ""; position: absolute; left: 2px; top: 8px; width: 5px; height: 5px;
    border-radius: 1px; background: var(--rule-strong); transform: rotate(45deg);
  }
  .svc-outcome {
    margin-top: auto; padding-top: 18px; font-size: 13.5px; line-height: 1.65; color: var(--text);
  }
  .svc-outcome .muted {
    display: block; font-family: var(--font-mono); font-size: 10.5px; text-transform: uppercase;
    letter-spacing: 0.12em; margin-bottom: 6px; color: var(--text-faint);
  }

  /* THREAT COVERAGE */
  .coverage { background: var(--surface); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .cov-head { max-width: 60ch; }
  .cov-title { font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1.25; }
  .owasp {
    list-style: none; margin: 32px 0 0; padding: 0;
    display: grid; gap: 1px; background: var(--rule);
    border: 1px solid var(--rule); border-radius: var(--radius-sm); overflow: hidden;
  }
  @media (min-width: 620px) { .owasp { grid-template-columns: repeat(2, 1fr); } }
  .owasp-item {
    display: flex; align-items: center; gap: 14px; padding: 14px 18px; background: var(--bg);
  }
  .owasp-code { font-family: var(--font-mono); font-size: 12px; color: var(--sunset); flex: 0 0 auto; width: 52px; }
  .owasp-name { font-size: 14.5px; color: var(--text); }

  /* PROCESS — vertical timeline */
  .process { background: var(--bg); }
  .timeline { list-style: none; margin: 44px 0 0; padding: 0; position: relative; display: grid; gap: 30px; }
  .timeline::before {
    content: ""; position: absolute; left: 17px; top: 8px; bottom: 8px; width: 2px;
    background: linear-gradient(var(--sunset), transparent 92%); opacity: 0.5;
  }
  .phase { display: grid; grid-template-columns: 36px 1fr; gap: 20px; position: relative; }
  .phase-node {
    width: 36px; height: 36px; border-radius: 50%; background: var(--surface-2);
    border: 1px solid var(--rule-strong); display: grid; place-items: center; z-index: 1;
  }
  .phase-node span { font-family: var(--font-mono); font-size: 12px; color: var(--sunset); }
  .phase-body h4 { font-size: 1.15rem; margin-bottom: 6px; padding-top: 6px; }
