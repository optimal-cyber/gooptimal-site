---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GatewayCanvas from "../../components/GatewayCanvas.astro";

// Whitepaper downloads post to Web3Forms, then we redirect to the PDF.
//
// Web3Forms over Formspree: the free tier allows 250 submissions/month rather
// than 50, that quota is not shared with the contact form, and `redirect` works
// without paying. The access key is a public UUID by design — it identifies the
// destination inbox, it is not a credential.
import { WEB3FORMS_ACCESS_KEY, pending } from "../../data/company.ts";

const WEB3FORMS_ENDPOINT = "https://api.web3forms.com/submit";

// No key yet? Skip the gate rather than render a form that silently drops
// leads. The page still sells the whitepaper and hands over the PDF.
const gated = !pending(WEB3FORMS_ACCESS_KEY);

// The gate is soft by design: this file stays at a public URL and is linked
// from the PDF itself. The form is for attribution, not access control.
const PDF_PATH = "/whitepapers/securing-agentic-ai.pdf";
const pdfUrl = new URL(PDF_PATH, Astro.site).href;

const covers = [
  "A threat model spanning goal hijack, indirect injection, memory and vector-store poisoning, tool supply chain, and the internal trust trap in multi-agent systems",
  "Authorization verified at the tool boundary, by a component the agent cannot influence",
  "Delegation that narrows and never widens, using token exchange with attenuation",
  "An evaluation methodology with numeric promotion gates and adaptive adversaries",
  "A continuous authorization (cATO) mapping for systems that change with every model update",
  "A control crosswalk to NIST SP 800-53 Rev 5 and ISO/IEC 42001",
];
---

<Layout
  title="Securing Agentic AI — whitepaper | Optimal"
  description="A reference architecture for running autonomous agents in regulated environments: enforcement at the tool boundary, bounded authorization blast radius, continuous authorization, and a control crosswalk to NIST SP 800-53 and ISO/IEC 42001."
  breadcrumbs={[{ name: "Home", href: "/" }]}
>
  <Header />

  <section class="section relative">
    <div class="glow"></div>
    <GatewayCanvas variant="ambient" align="center" density={0.55} />
    <div class="container z wrap">
      <div class="intro">
        <span class="eyebrow">Whitepaper</span>
        <h1 class="h2">Securing Agentic AI</h1>
        <p class="sub">Governing What the System Does, Not What It Says</p>
        <p class="lead" style="margin-top:16px;">
          Your agent is perfectly sandboxed. It can still delete the production
          database, because deleting the database is something it was permitted
          to do. This is a reference architecture for bounding what agents are
          allowed to do — written for FedRAMP, CJIS, and CMMC boundaries.
        </p>

        <h2 class="ct-h">What&rsquo;s inside</h2>
        <ul class="covers">
          {covers.map((c) => <li>{c}</li>)}
        </ul>

        <p class="muted read-first">
          Prefer the short version first? Read
          <a href="/blog/authorization-blast-radius/">The Authorization Blast Radius</a>.
        </p>
      </div>

      {gated ? (
      <form class="card form" id="wp-form" method="POST" action={WEB3FORMS_ENDPOINT} data-pdf={PDF_PATH}>
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="Optimal · Whitepaper download — Securing Agentic AI" />
        <input type="hidden" name="from_name" value="gooptimal.io" />
        <input type="hidden" name="asset" value="Securing Agentic AI" />
        {/* Works on the free tier, so the no-JS path still lands on the PDF. */}
        <input type="hidden" name="redirect" value={pdfUrl} />
        {/* Web3Forms' honeypot: any submission with this filled is dropped. */}
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" style="display:none" />

        <p class="form-h">Get the whitepaper</p>
        <label>Name<input type="text" name="name" required /></label>
        <label>Work email<input type="email" name="email" required /></label>
        <label>Organization<input type="text" name="organization" /></label>
        <button type="submit" class="btn btn-primary">Download the whitepaper →</button>
        <p class="status" id="wp-status" role="status" aria-live="polite" hidden></p>
        <p class="muted privacy">
          We use this to know who&rsquo;s reading and to follow up once if it looks
          relevant. No list, no sharing, no tracking pixels. Email
          <a href="mailto:ryan@gooptimal.io">ryan@gooptimal.io</a> and we&rsquo;ll delete it.
        </p>
      </form>
      ) : (
      <div class="card form">
        <p class="form-h">Get the whitepaper</p>
        <p class="muted privacy">
          19 pages on bounding what autonomous agents are allowed to do, free and
          no sign-up.
        </p>
        <a class="btn btn-primary" href={PDF_PATH}>Download the whitepaper →</a>
      </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Web3Forms' `redirect` field works on the free tier, so the no-JS path is
  // already correct. Submitting over AJAX is still better: the reader never
  // bounces through a third-party page, and we can fail open.
  const form = document.getElementById("wp-form");
  const status = document.getElementById("wp-status");
  const pdf = form?.dataset.pdf;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;
    status.hidden = true;

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const body = await res.json().catch(() => null);

      if (res.ok && body?.success) {
        window.location.href = pdf;
        return;
      }

      // Never withhold the file over a backend problem that is not the
      // reader's — a spent quota or a bad key must not cost them the download.
      status.textContent = body?.message
        ? `Could not record that (${body.message}). Opening the whitepaper anyway…`
        : "Could not record that. Opening the whitepaper anyway…";
      status.hidden = false;
      setTimeout(() => { window.location.href = pdf; }, 1600);
    } catch {
      status.textContent = "Network error. Opening the whitepaper anyway…";
      status.hidden = false;
      setTimeout(() => { window.location.href = pdf; }, 1600);
    }
  });
</script>

<style>
  .wrap { display: grid; gap: 40px; align-items: start; }
  .intro { padding-top: 6px; }
  .sub {
    margin-top: 8px; font-size: 15px; color: var(--text-dim);
    font-style: italic;
  }
  .ct-h {
    margin-top: 30px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint);
  }
  .covers { margin: 16px 0 0; padding-left: 1.15em; display: grid; gap: 0.55em; color: var(--text-dim); font-size: 15px; }
  .covers li::marker { color: var(--sunset); }
  .read-first { margin-top: 24px; font-size: 14px; }
  .read-first a { color: var(--sunset); }
  .form { display: grid; gap: 16px; }
  .form-h { font-family: var(--font-body); font-weight: 600; color: var(--text); font-size: 16px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  label { display: grid; gap: 7px; font-size: 13px; color: var(--text-dim); }
  input {
    width: 100%; font: inherit; color: var(--text);
    background: var(--bg); border: 1px solid var(--rule); border-radius: var(--radius-sm);
    padding: 11px 13px; outline: none; transition: border-color .2s ease;
  }
  input:focus { border-color: var(--sunset); }
  .form .btn { justify-self: start; margin-top: 6px; }
  .privacy { font-size: 12.5px; line-height: 1.6; }
  .status { font-size: 13px; color: var(--sunset); }
  .privacy a { color: var(--sunset); }
  @media (min-width: 900px) {
    .wrap { grid-template-columns: 1fr 1fr; gap: 64px; }
  }
</style>
