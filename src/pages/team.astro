---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GatewayCanvas from "../components/GatewayCanvas.astro";
import VetBadge from "../components/VetBadge.astro";

// ---------------------------------------------------------------------------
// Leadership facts. Everything rendered below is asserted publicly on a site
// that sells to the defense industrial base — so nothing here is inferred or
// approximated. The two arrays below are intentionally empty until the real
// specifics are supplied; their sections do not render while empty.
//
//   service     — branch, role/rating, and years. e.g.
//                 { label: "U.S. Army", detail: "Infantry · 2004–2012" }
//   credentials — certifications, clearances, degrees. e.g.
//                 { label: "CISSP", detail: "ISC² · active" }
// ---------------------------------------------------------------------------
const service: { label: string; detail: string }[] = [];
const credentials: { label: string; detail: string }[] = [];

const hasBackground = service.length > 0 || credentials.length > 0;

// What the founder holds the firm to. These restate commitments the rest of the
// site already makes — they are positioning, not biography.
const principles = [
  {
    idx: "01",
    accent: "var(--sunset)",
    title: "Adversary-informed, not compliance-driven",
    body: "A control that passes an audit and fails an attacker is a liability with paperwork. We start from how these systems actually get broken, then map the result back to NIST SP 800-171, CMMC, and the AI RMF — in that order.",
  },
  {
    idx: "02",
    accent: "var(--steel)",
    title: "Sovereign by default",
    body: "Your enclave, your tenancy, your keys, your logs. We build and run the environment; we do not become a dependency you can't remove. Nothing about the way we work should make your data harder to control.",
  },
  {
    idx: "03",
    accent: "var(--seafoam)",
    title: "Honest about the line we don't cross",
    body: "We engineer environments to be assessment-ready and we say so plainly. Optimal is not a C3PAO and does not grant an ATO — that assessment is independent, by design, and any firm that blurs it is selling you risk.",
  },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ryan Gutwein",
  jobTitle: "Founder & Chief Executive Officer",
  email: "ryan@gooptimal.io",
  image: "https://gooptimal.io/team/ryan-gutwein.jpg",
  url: "https://gooptimal.io/team",
  worksFor: {
    "@type": "Organization",
    name: "Optimal",
    legalName: "Optimal, LLC",
    url: "https://gooptimal.io",
  },
  description:
    "Ryan Gutwein is the founder and CEO of Optimal, LLC, an SBA-certified Service-Disabled Veteran-Owned Small Business that builds and manages CMMC-ready Microsoft 365 GCC High enclaves for the defense industrial base and stands up the governed AI that runs inside them.",
};
---

<Layout
  title="Team — Ryan Gutwein, Founder & CEO of Optimal"
  description="Optimal is led by founder and CEO Ryan Gutwein, a service-disabled veteran. Optimal, LLC is an SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB) building and managing CMMC-ready GCC High enclaves and governed AI for the defense industrial base."
  keywords="Ryan Gutwein, Optimal LLC founder, Optimal CEO, SDVOSB leadership, service-disabled veteran owned, GCC High MSP leadership, defense industrial base, CMMC, governed AI"
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />

  <!-- HERO / LEADERSHIP -->
  <section class="hero relative">
    <div class="glow"></div>
    <GatewayCanvas variant="hero" />
    <div class="container z">
      <span class="eyebrow">Leadership</span>
      <h1 class="display">The person<br /><span class="grad">accountable for the work.</span></h1>
      <p class="lead">
        Optimal is deliberately small. The people who scope an engagement are the people who build
        the enclave and answer the phone when something breaks &mdash; there is no layer between the
        sales conversation and the engineering.
      </p>
    </div>
  </section>

  <!-- FOUNDER -->
  <section id="founder" class="section--tight founder">
    <div class="container">
      <div class="fgrid">
        <aside class="fcard">
          <div class="portrait">
            <img
              src="/team/ryan-gutwein.jpg"
              width="200"
              height="200"
              alt="Ryan Gutwein, Founder and CEO of Optimal"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <h2 class="fname">Ryan Gutwein</h2>
          <p class="frole">Founder &amp; Chief Executive Officer</p>
          <p class="fvet">Service-disabled veteran</p>
          <ul class="flinks">
            <li><a href="mailto:ryan@gooptimal.io">ryan@gooptimal.io</a></li>
            <li><a href="/contact">Book a scoping call &rarr;</a></li>
          </ul>
        </aside>

        <div class="fbody">
          <span class="ix">From the founder</span>
          <p class="fpull">
            &ldquo;The defense industrial base was handed two problems at once &mdash; prove you can
            hold CUI, and adopt AI without losing control of it. Most firms will sell you one and
            quietly make the other worse.&rdquo;
          </p>
          <div class="fprose">
            <p>
              I started Optimal to do both jobs properly, and to do them in the customer&rsquo;s own
              environment. We build, migrate, and run CMMC-ready Microsoft 365 GCC High enclaves for
              contractors handling CUI and ITAR-controlled data &mdash; and then we stand up the
              governed access layer that lets frontier models be genuinely useful inside that
              boundary instead of routing around it.
            </p>
            <p>
              Those two things belong to the same problem. An enclave that people work around is not
              a boundary, it is a formality. Once a team has a real reason to paste controlled data
              into an unapproved tool, every control upstream of that moment stops counting. So the
              answer is not to ban the capability &mdash; it is to make the governed path the fastest
              one: authenticated gateway, prompt guardrails, default-deny egress, and an auditable
              trail that stands up in an assessment.
            </p>
            <p>
              We are also clear about what we are not. Optimal engineers environments to be
              assessment-ready; the certified assessment is performed independently by a C3PAO, and
              we do not grant authorizations. That separation exists for good reasons, and we would
              rather explain it up front than be the vendor who let a customer misunderstand their
              own position.
            </p>
            <p>
              Everything we claim we can build, we have built. NINELINE is our working reference
              implementation, and the AI gateway architecture is public. If you want to see how we
              think before you hire us, start there &mdash; then let&rsquo;s talk about your
              environment.
            </p>
          </div>
          <p class="fsign">Ryan Gutwein &mdash; Founder &amp; CEO, Optimal, LLC</p>
        </div>
      </div>
    </div>
  </section>

  {hasBackground && (
    <section id="background" class="section--tight background">
      <div class="container">
        <div class="sec-head wide">
          <span class="ix">Background</span>
          <h2 class="cov-title">Service and credentials.</h2>
        </div>
        <div class="bg-cols">
          {service.length > 0 && (
            <div class="bg-col">
              <h4 class="bg-h">Military service</h4>
              <ul class="factlist">
                {service.map((s) => (
                  <li class="fact">
                    <span class="fact-k">{s.label}</span>
                    <span class="fact-v muted">{s.detail}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {credentials.length > 0 && (
            <div class="bg-col">
              <h4 class="bg-h">Certifications &amp; education</h4>
              <ul class="factlist">
                {credentials.map((c) => (
                  <li class="fact">
                    <span class="fact-k">{c.label}</span>
                    <span class="fact-v muted">{c.detail}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- PRINCIPLES -->
  <section id="principles" class="section principles relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">How we operate</span>
        <h2 class="h2">Three commitments, held by the person who signs the work.</h2>
      </div>
      <div class="pr-grid">
        {principles.map((p) => (
          <article class="card pr">
            <span class="pr-ix" style={`color:${p.accent}`}>{p.idx}</span>
            <h3>{p.title}</h3>
            <p class="muted pr-body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SDVOSB -->
  <section class="section--tight vetstrip">
    <div class="container vet-inner">
      <VetBadge size={104} />
      <div class="vet-copy">
        <h3 class="vet-h">An SBA-certified Service-Disabled Veteran-Owned Small Business.</h3>
        <p class="muted">
          Optimal, LLC is certified through the SBA Veteran Small Business Certification (VetCert)
          program as both an SDVOSB and a VOSB, and is eligible to compete for SDVOSB and VOSB
          set-aside contracts. The certification is publicly verifiable on the
          <a href="https://search.certifications.sba.gov/" target="_blank" rel="noopener">SBA certification registry</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta relative">
    <div class="glow"></div>
    <GatewayCanvas variant="ambient" align="center" density={0.7} />
    <div class="container z cta-inner">
      <h2 class="display" style="font-size:clamp(2rem,5vw,3.4rem);">Talk to the person<br />doing the work.</h2>
      <p class="lead" style="margin:18px auto 0;">
        Scoping calls are run by the founder, not a sales team. Bring your contract requirements and
        your environment as it actually is &mdash; we&rsquo;ll tell you what it takes.
      </p>
      <div class="cta-row" style="justify-content:center;">
        <a href="/contact" class="btn btn-primary" style="margin-top:28px;">Book a scoping call &rarr;</a>
        <a href="/gcc-high" class="btn btn-ghost" style="margin-top:28px;">Managed GCC High</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Shared editorial kicker (matches homepage / NINELINE) */
  .ix {
    display: inline-block; font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint);
    margin-bottom: 16px;
  }
  .sec-head.wide { max-width: 62ch; }
  .cov-title { font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1.25; }

  /* HERO */
  .hero { padding: clamp(72px, 12vw, 140px) 0 clamp(40px, 6vw, 72px); }
  .hero .eyebrow { margin-bottom: 22px; }
  .hero h1 { margin-bottom: 24px; }
  .hero .lead { font-size: clamp(17px, 2.2vw, 21px); }

  /* FOUNDER */
  .founder { border-top: 1px solid var(--rule); }
  .fgrid { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 900px) {
    .fgrid { grid-template-columns: 300px 1fr; gap: 64px; }
    .fcard { position: sticky; top: 100px; }
  }

  .fcard {
    padding: 28px; border: 1px solid var(--rule); border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
  }
  .portrait {
    width: 176px; height: 176px; border-radius: 50%; padding: 3px;
    background: var(--grad-sunset); margin-bottom: 22px;
  }
  .portrait img {
    width: 100%; height: 100%; border-radius: 50%; object-fit: cover;
    border: 3px solid var(--surface); background: var(--surface-2);
  }
  .fname { font-size: 1.5rem; margin-bottom: 6px; }
  .frole { font-size: 14px; color: var(--sunset); font-weight: 600; letter-spacing: 0.01em; }
  .fvet {
    margin-top: 12px; font-family: var(--font-mono); font-size: 11.5px;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint);
  }
  .flinks {
    list-style: none; margin: 22px 0 0; padding: 22px 0 0; display: grid; gap: 10px;
    border-top: 1px solid var(--rule);
  }
  .flinks a { font-size: 14px; color: var(--text-dim); transition: color .2s ease; }
  .flinks a:hover { color: var(--sunset); }

  .fpull {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.15rem, 2.4vw, 1.6rem); line-height: 1.35; letter-spacing: -0.02em;
    color: var(--text); border-left: 3px solid var(--sunset); padding: 4px 0 4px 24px;
    margin-bottom: 30px; max-width: 60ch;
  }
  .fprose { display: grid; gap: 20px; max-width: 66ch; }
  .fprose p { color: var(--text-dim); font-size: 16px; line-height: 1.75; }
  .fsign {
    margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--rule);
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--text-faint);
  }

  /* BACKGROUND (renders only when the service/credentials arrays are populated) */
  .background {
    background: var(--surface);
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
  }
  .bg-cols { display: grid; gap: 32px; margin-top: 32px; }
  @media (min-width: 760px) { .bg-cols { grid-template-columns: repeat(2, 1fr); gap: 48px; } }
  .bg-h {
    font-family: var(--font-body); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--text-faint); margin-bottom: 16px;
  }
  .factlist { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .fact {
    display: flex; flex-wrap: wrap; gap: 4px 16px; justify-content: space-between;
    align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--rule);
  }
  .fact-k { font-family: var(--font-display); font-size: 1rem; color: var(--text); }
  .fact-v { font-size: 13.5px; }

  /* PRINCIPLES */
  .principles { background: var(--bg); }
  .pr-grid { display: grid; gap: 20px; margin-top: 42px; }
  @media (min-width: 900px) { .pr-grid { grid-template-columns: repeat(3, 1fr); } }
  .pr { display: flex; flex-direction: column; }
  .pr-ix { font-family: var(--font-mono); font-size: 13px; font-weight: 600; letter-spacing: 0.05em; margin-bottom: 14px; }
  .pr h3 { font-size: 1.15rem; margin-bottom: 10px; }
  .pr-body { font-size: 14.5px; line-height: 1.7; }

  /* SDVOSB STRIP */
  .vetstrip { background: var(--surface); border-top: 1px solid var(--rule); }
  .vet-inner { display: flex; flex-wrap: wrap; gap: 28px; align-items: center; }
  .vet-copy { flex: 1 1 380px; }
  .vet-h { font-size: clamp(1.1rem, 2.2vw, 1.4rem); margin-bottom: 10px; }
  .vet-copy p { font-size: 14px; line-height: 1.7; max-width: 72ch; }
  .vet-copy a { color: var(--sunset); }
  .vet-copy a:hover { color: var(--ember); }

  /* CTA */
  .cta { background: var(--surface); border-top: 1px solid var(--rule); }
  .cta-inner { text-align: center; max-width: 720px; margin: 0 auto; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; }
</style>
