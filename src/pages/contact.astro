---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GatewayCanvas from "../components/GatewayCanvas.astro";
import VetBadge from "../components/VetBadge.astro";
import { CAGE, UEI, NAICS_CODES, capabilityStatementHref, pending, WEB3FORMS_ACCESS_KEY } from "../data/company.ts";

// The old Formspree form (f/xovqzpkj) now returns "Form not found" — dead
// endpoint, submissions silently lost. Scoping requests post to Web3Forms
// instead, on the same access key as the whitepaper gate; the `subject`
// hidden field is what tells the two apart in the inbox.
const WEB3FORMS_ENDPOINT = "https://api.web3forms.com/submit";
const formLive = !pending(WEB3FORMS_ACCESS_KEY);

// What a contracting officer or a prime's subcontracts group looks for before
// they bother with the form. NAICS renders once the codes are confirmed.
const contracting = [
  { k: "CAGE", v: CAGE },
  { k: "UEI", v: UEI },
  ...(pending(NAICS_CODES) ? [] : [{ k: "NAICS", v: NAICS_CODES }]),
  { k: "Set-aside", v: "SDVOSB · VOSB (SBA VetCert)" },
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Book a scoping call with Optimal",
  url: "https://gooptimal.io/contact",
  description:
    "Scope a managed GCC High enclave, a CMMC readiness engagement, or an AI security assessment with Optimal. Calls are run by the founder directly.",
  mainEntity: {
    "@type": "Organization",
    name: "Optimal",
    url: "https://gooptimal.io",
    email: "ryan@gooptimal.io",
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "sales",
      email: "ryan@gooptimal.io",
      areaServed: "US",
      availableLanguage: "English",
    },
  },
};
---

<Layout
  title="Book a scoping call — managed GCC High & AI security | Optimal"
  description="Scope a managed Microsoft 365 GCC High enclave, CMMC Level 2 readiness, or an AI security assessment. Tell us your contracts, your data, and your environment — GovCloud, commercial cloud, on-prem, or air-gapped. Calls are run by the founder directly."
  breadcrumbs={[{ name: "Home", href: "/" }]}
  jsonLd={[contactSchema]}
>
  <Header />

  <section class="section relative">
    <div class="glow"></div>
    <GatewayCanvas variant="ambient" align="center" density={0.55} />
    <div class="container z wrap">
      <div class="intro">
        <span class="eyebrow">Book a scoping call</span>
        <h1 class="h2">Let&rsquo;s scope the work.</h1>
        <p class="lead" style="margin-top:16px;">
          Tell us the contracts you&rsquo;re chasing, the data you handle, and where you
          are today. We&rsquo;ll scope the right engagement — a managed GCC&nbsp;High
          environment, CMMC readiness, an AI assessment or red team, or governed AI
          engineering — across GovCloud, commercial cloud, on-prem, or air-gapped.
        </p>
        <p class="muted email">
          Prefer email? <a href="mailto:ryan@gooptimal.io">ryan@gooptimal.io</a>
        </p>
        <div class="vet-wrap">
          <VetBadge size={92} />
          <p class="muted vet-note">
            Optimal, LLC is an SBA-certified Service-Disabled Veteran-Owned Small
            Business (SDVOSB), eligible for SDVOSB and VOSB set-aside contracts.
          </p>
        </div>

        <div class="contracting">
          <h2 class="ct-h">Contracting details</h2>
          <dl class="ct-list">
            {contracting.map((c) => (
              <div class="ct-row">
                <dt>{c.k}</dt>
                <dd>{c.v}</dd>
              </div>
            ))}
          </dl>
          <a href={capabilityStatementHref} class="btn btn-ghost ct-cta">Download capability statement →</a>
        </div>
      </div>

      {formLive ? (
      <form class="card form" id="contact-form" method="POST" action={WEB3FORMS_ENDPOINT}>
        <!-- Web3Forms config: destination key, email subject, honeypot spam trap -->
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="Optimal · Scoping call request" />
        <input type="hidden" name="from_name" value="gooptimal.io" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" style="display:none" />
        <div class="row">
          <label>Name<input type="text" name="name" required /></label>
          <label>Work email<input type="email" name="email" required /></label>
        </div>
        <div class="row">
          <label>Organization<input type="text" name="organization" /></label>
          <label>Environment
            <select name="boundary">
              <option>Commercial Microsoft 365</option>
              <option>GCC</option>
              <option>GCC High</option>
              <option>FedRAMP</option>
              <option>IL4 / IL5</option>
              <option>IL6</option>
              <option>On-prem / air-gapped</option>
            </select>
          </label>
        </div>
        <label>What do you need?<textarea name="message" rows="4" placeholder="Models, clouds, timeline…"></textarea></label>
        <button type="submit" class="btn btn-primary">Send request →</button>
        <p class="status" id="contact-status" role="status" aria-live="polite" hidden></p>
      </form>
      ) : (
      <div class="card form">
        <p>The request form is briefly offline. Email
          <a href="mailto:ryan@gooptimal.io">ryan@gooptimal.io</a> and we&rsquo;ll take it from there.</p>
      </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Submit over AJAX so the visitor never bounces through Web3Forms' own
  // thank-you page — success and failure both land as an inline note here.
  const form = document.getElementById("contact-form");
  const status = document.getElementById("contact-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;
    status.hidden = true;

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const body = await res.json().catch(() => null);

      if (res.ok && body?.success) {
        status.textContent = "Request sent — we'll get back to you within one business day.";
        status.hidden = false;
        form.reset();
      } else {
        status.textContent = "That didn't go through. Email ryan@gooptimal.io and we'll take it from there.";
        status.hidden = false;
        button.disabled = false;
      }
    } catch {
      status.textContent = "Network error — email ryan@gooptimal.io and we'll take it from there.";
      status.hidden = false;
      button.disabled = false;
    }
  });
</script>

<style>
  .wrap { display: grid; gap: 40px; align-items: start; }
  .intro { padding-top: 6px; }
  .email { margin-top: 22px; font-size: 14px; }
  .email a { color: var(--sunset); }
  .vet-wrap { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .vet-wrap .vet-note { font-size: 13px; max-width: 34ch; flex: 1 1 220px; }
  .contracting { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .ct-h {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint);
  }
  .ct-list { margin: 16px 0 0; display: grid; gap: 0; }
  .ct-row { display: grid; gap: 3px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 480px) { .ct-row { grid-template-columns: 110px 1fr; gap: 16px; align-items: baseline; } }
  .ct-list dt {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--text-faint);
  }
  .ct-list dd { margin: 0; font-family: var(--font-mono); font-size: 13.5px; color: var(--text-dim); }
  .ct-cta { margin-top: 22px; }
  .form { display: grid; gap: 16px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .row { display: grid; gap: 16px; }
  label { display: grid; gap: 7px; font-size: 13px; color: var(--text-dim); }
  input, select, textarea {
    width: 100%; font: inherit; color: var(--text);
    background: var(--bg); border: 1px solid var(--rule); border-radius: var(--radius-sm);
    padding: 11px 13px; outline: none; transition: border-color .2s ease;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--sunset); }
  .form .btn { justify-self: start; margin-top: 6px; }
  .status { font-size: 13px; color: var(--sunset); }
  @media (min-width: 900px) {
    .wrap { grid-template-columns: 1fr 1fr; gap: 64px; }
    .row { grid-template-columns: 1fr 1fr; }
  }
</style>
