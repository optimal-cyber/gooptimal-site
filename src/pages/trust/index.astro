---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

// The trust center's public half. Every value on this page comes from the JSON files under
// public/trust/nineline/, which fedramp-package/tools/export_trust.py (9line repository)
// writes from the generated FedRAMP package; the same files are published for download, so
// the human-readable page and the machine-readable data cannot disagree (CDS-CSO-CBF).
// Nothing here is typed by hand. The package itself (CPO, SDR with daily KSI data, reports)
// is behind sign-in, not on this page (CDS-CSO-RIS).
import pub from "../../../public/trust/nineline/public-information.json";
import ksi from "../../../public/trust/nineline/ksi-status.json";
import progress from "../../../public/trust/nineline/progress.json";
import vdr from "../../../public/trust/nineline/vdr-ver-status.json";
import vuln from "../../../public/trust/nineline/vulnerability-summary.json";

const STATUS: Record<string, { label: string; cls: string }> = {
  "Implemented": { label: "Implemented", cls: "ok" },
  "Partially Implemented": { label: "Partially implemented", cls: "part" },
  "Not Implemented": { label: "Not yet implemented", cls: "none" },
};
const MS: Record<string, { label: string; cls: string }> = {
  done: { label: "Done", cls: "ok" },
  in_progress: { label: "In progress", cls: "part" },
  not_started: { label: "Not started", cls: "none" },
};
const date = (iso: string) => iso ? new Date(iso).toISOString().slice(0, 10) : "";
const t = ksi.totals;
const pct = (n: number) => `${(100 * n / t.ksis).toFixed(1)}%`;
const vt = vdr.totals;
const RATING_COLS = ["N5", "N4", "N3", "N2", "N1", "N0", "unrated"] as const;

const facts: [string, string][] = [
  ["FedRAMP ID", pub.fedRampIdAssigned ? pub.fedRampId : `${pub.fedRampId} (FedRAMP assigns an ID on listing)`],
  ["Provider", pub.provider],
  ["Certification sought", `FedRAMP ${pub.certificationType} Class ${pub.certificationClassSought}, ${pub.certificationPath} path`],
  ["Service model", pub.serviceModel.join(", ")],
  ["Deployment model", pub.deploymentModel],
  ["Business category", pub.businessCategory.join(", ")],
  ["UEI", pub.ueiNumber],
  ["Security contact", `${pub.securityContact.contactName} · ${pub.securityContact.contactEmail}`],
  ["Sales contact", `${pub.salesContact.contactName} · ${pub.salesContact.contactEmail}`],
];

const files = [
  { name: "Certification Package Overview", json: "cpo.json", md: null, rule: "FRC-CSO-PKG" },
  { name: "Public information", json: "public-information.json", md: "public-information.md", rule: "CDS-CSO-PUB" },
  { name: "Key Security Indicator status", json: "ksi-status.json", md: "ksi-status.md", rule: "KSI" },
  { name: "Progress toward certification", json: "progress.json", md: "progress.md", rule: "MKT-IIP-DCP" },
  { name: "Vulnerability rules (VDR and VER) status", json: "vdr-ver-status.json", md: "vdr-ver-status.md", rule: "VDR, VER" },
  { name: "Open vulnerabilities by resource and rating", json: "vulnerability-summary.json", md: "vulnerability-summary.md", rule: "VER-EVA-EPA" },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "9line Trust Center",
  url: "https://gooptimal.io/trust/",
  about: { "@type": "SoftwareApplication", name: "9line", url: pub.productWebsite },
  publisher: { "@type": "Organization", name: pub.provider, url: "https://gooptimal.io" },
  dateModified: ksi.generatedAt,
};
---

<Layout
  title="9line Trust Center — FedRAMP 20x Class C progress — Optimal"
  description="9line's trust center: public FedRAMP information, the status of every FedRAMP 20x Key Security Indicator, progress toward Class C certification, and access to the certification package for agencies, FedRAMP and assessors."
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "9line", href: "/nineline" }]}
  jsonLd={[orgSchema]}
>
  <Header />

  <section class="section--tight relative">
    <div class="glow"></div>
    <div class="container z">
      <span class="eyebrow">Trust center · {pub.service}</span>
      <h1 class="display trust-h1">9line Trust Center</h1>
      <p class="lead">{pub.description}</p>
      <div class="notice">
        <strong>Status: pursuing FedRAMP 20x Class C. Not FedRAMP certified.</strong>
        This page reports where {pub.service} stands against every Key Security Indicator, generated from
        the same data as the certification package and updated whenever it changes. Last updated {date(ksi.generatedAt)}.
      </div>
      <div class="jump">
        <a class="btn btn-ghost" href="#ksi">Key Security Indicators</a>
        <a class="btn btn-ghost" href="#vdr">Vulnerability rules</a>
        <a class="btn btn-ghost" href="#vulns">Vulnerabilities by rating</a>
        <a class="btn btn-ghost" href="#progress">Progress</a>
        <a class="btn btn-ghost" href="#package">Certification package</a>
        <a class="btn btn-ghost" href="#data">Machine-readable data</a>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <h2 class="h2">Public information</h2>
      <dl class="facts">
        {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
    </div>
  </section>

  <section id="ksi" class="section--tight">
    <div class="container">
      <h2 class="h2">Key Security Indicators</h2>
      <p class="muted narrow">
        FedRAMP 20x defines {t.ksis} Key Security Indicators in ten themes. Class C requires each to be
        persistently validated by at least two automated methods, with 30 days of daily results.
        Select an indicator for FedRAMP's statement, the controls it maps to, and how it is validated.
      </p>

      <div class="totals" role="img" aria-label={`${t.Implemented} implemented, ${t["Partially Implemented"]} partially implemented, ${t["Not Implemented"]} not yet implemented, of ${t.ksis}`}>
        <div class="bar">
          <span class="seg ok" style={`width:${pct(t.Implemented)}`}></span>
          <span class="seg part" style={`width:${pct(t["Partially Implemented"])}`}></span>
          <span class="seg none" style={`width:${pct(t["Not Implemented"])}`}></span>
        </div>
        <ul class="legend">
          <li><span class="dot ok"></span>{t.Implemented} implemented</li>
          <li><span class="dot part"></span>{t["Partially Implemented"]} partially implemented</li>
          <li><span class="dot none"></span>{t["Not Implemented"]} not yet implemented</li>
          <li class="muted">Daily automated validation: {ksi.dailyValidationRunning ? "running" : "starting with the boundary deployment"}</li>
        </ul>
      </div>

      <div class="themes">
        {ksi.themes.map((th) => (
          <div class="theme">
            <div class="theme-h"><span class="abbr">{th.abbr}</span><b>{th.name}</b><span class="n">{th.ksis.length}</span></div>
            {th.ksis.map((k) => {
              const s = STATUS[k.status] ?? STATUS["Not Implemented"];
              const m = k.validationMethods;
              const autoTotal = m.automatedOperating + m.automatedPlanned;
              const d = k.dailyValidation;
              return (
                <details class="ksi">
                  <summary>
                    <span class="kname">{k.name}</span>
                    <span class={`pill ${s.cls}`}>{s.label}</span>
                    <span class="kid">{k.id}</span>
                  </summary>
                  <div class="kbody">
                    <p class="stmt">{k.statement}</p>
                    <dl class="kfacts">
                      <div><dt>Requirement at Class C</dt><dd>{k.force}</dd></div>
                      <div><dt>Automated validation methods</dt><dd>{m.automatedOperating} operating of {autoTotal} defined{autoTotal < 2 ? " (Class C needs at least 2)" : ""}</dd></div>
                      <div><dt>Manual reviews</dt><dd>{m.manualOperating + m.manualPlanned}</dd></div>
                      <div><dt>Daily validation, last 30 days</dt><dd>{d ? `${d.pass} pass · ${d.fail} fail · ${d.noData} no data (current: ${d.current})` : "Not running yet"}</dd></div>
                      <div class="wide"><dt>NIST SP 800-53 controls</dt><dd class="mono">{k.controls.join(", ")}</dd></div>
                    </dl>
                  </div>
                </details>
              );
            })}
          </div>
        ))}
      </div>
      <p class="src">Statements: FedRAMP Consolidated Rules {ksi.rulesVersion} (github.com/FedRAMP/rules). Status: 9line Security Decision Record, updated {date(ksi.sdrUpdated)}.</p>
    </div>
  </section>

  <section id="vdr" class="section--tight">
    <div class="container">
      <h2 class="h2">Vulnerability detection, evaluation and reporting</h2>
      <p class="muted narrow">
        FedRAMP 20x sets {vt.rules} rules for how a provider detects vulnerabilities and responds (VDR) and how it
        evaluates and reports them (VER). They are required for new 20x applications from {vdr.effective.required},
        with grace to {vdr.effective.graceUntil}. Each entry below is FedRAMP's rule as it applies at Class C,
        with the status of 9line's own boundary against it. 9line implements these same rules for the
        customers it runs inside; the status here is Optimal's hosted service, which is being deployed.
      </p>
      <div class="totals">
        <div class="bar">
          <span class="seg ok" style={`width:${(100 * vt.Implemented / vt.rules).toFixed(1)}%`}></span>
          <span class="seg part" style={`width:${(100 * vt["Partially Implemented"] / vt.rules).toFixed(1)}%`}></span>
          <span class="seg none" style={`width:${(100 * vt["Not Implemented"] / vt.rules).toFixed(1)}%`}></span>
        </div>
        <ul class="legend">
          <li><span class="dot ok"></span>{vt.Implemented} implemented</li>
          <li><span class="dot part"></span>{vt["Partially Implemented"]} partially implemented</li>
          <li><span class="dot none"></span>{vt["Not Implemented"]} not yet implemented</li>
        </ul>
      </div>
      <div class="themes rules">
        {vdr.families.map((f) => (
          <div class="theme">
            <div class="theme-h"><span class="abbr">{f.family}</span><b>{f.name}</b><span class="n">{f.rules.length}</span></div>
            {f.rules.map((r) => {
              const s = STATUS[r.status] ?? STATUS["Not Implemented"];
              return (
                <details class="ksi">
                  <summary>
                    <span class="kname">{r.name}</span>
                    <span class={`pill ${s.cls}`}>{s.label}</span>
                    <span class="kid">{r.id} · {r.force}{r.timeframeAtClassC ? ` · ${r.timeframeAtClassC}` : ""}</span>
                  </summary>
                  <div class="kbody">
                    <p class="stmt">{r.statement}</p>
                    {r.details.length > 0 && <ul class="stmt-list">{r.details.map((b) => <li>{b}</li>)}</ul>}
                  </div>
                </details>
              );
            })}
          </div>
        ))}
      </div>
      <p class="src">Rule text: FedRAMP Consolidated Rules {vdr.rulesVersion}. Status: 9line Security Decision Record.</p>
    </div>
  </section>

  <section id="vulns" class="section--tight">
    <div class="container">
      <h2 class="h2">Open vulnerabilities by information resource and rating</h2>
      <p class="muted narrow">
        Every vulnerability 9line detects, whatever it lives in, is evaluated the same way: is it
        internet-reachable, is it likely exploitable, and what is its Potential Agency Impact, the N0 to N5
        rating FedRAMP uses to set remediation timeframes (VER-EVA-EPA). This table counts the open ones by
        the type of information resource and by rating. Counts only; the vulnerabilities themselves are in
        the certification package.
      </p>
      {vuln.running ? (
        <table class="dl matrix">
          <thead><tr><th>Resource type</th><th>Resources</th><th>Open</th><th>KEV</th>{RATING_COLS.map((c) => <th>{c === "unrated" ? "Unrated" : c}</th>)}</tr></thead>
          <tbody>
            {vuln.types.map((r) => (
              <tr><td>{r.label}</td><td>{r.resources}</td><td>{r.open}</td><td>{r.kev}</td>{RATING_COLS.map((c) => <td>{r.byRating[c]}</td>)}</tr>
            ))}
            <tr class="total"><td>All</td><td>{vuln.totals.resources}</td><td>{vuln.totals.open}</td><td>{vuln.totals.kev}</td>{RATING_COLS.map((c) => <td>{vuln.totals.byRating[c]}</td>)}</tr>
          </tbody>
        </table>
      ) : (
        <div class="card pending">
          <p><strong>Not running yet.</strong> {vuln.note}</p>
          <ul class="types">{vuln.resourceTypes.map((x) => <li>{x}</li>)}</ul>
        </div>
      )}
      {vuln.running && <p class="src">As of {vuln.asOf}. Source: 9line, GET /api/fedramp/pain-summary.</p>}
    </div>
  </section>

  <section id="progress" class="section--tight">
    <div class="container">
      <h2 class="h2">Progress toward certification</h2>
      <p class="muted narrow">{progress.goal}. {progress.counts.done} of {progress.milestones.length} milestones complete. Updated at least quarterly.</p>
      <ol class="milestones">
        {progress.milestones.map((m) => {
          const s = MS[m.status];
          return (
            <li>
              <span class={`pill ${s.cls}`}>{s.label}</span>
              <div>
                <b>{m.title}</b>
                <p class="muted">{m.detail}</p>
                <p class="when">{m.done ? `Completed ${m.done}` : m.target ? `Target ${m.target}` : "Target date to be published"}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section id="package" class="section--tight">
    <div class="container">
      <h2 class="h2">Certification package</h2>
      <div class="card pkg">
        <p>
          The FedRAMP certification package (the Certification Package Overview, the Security Decision
          Record with daily Key Security Indicator data, and vulnerability detection and response reports)
          is available to federal agencies, the FedRAMP PMO and our independent assessor. Access requires
          an account with multi-factor authentication; every access is logged.
        </p>
        <p class="muted">
          To request access, email <a href={`mailto:${pub.securityContact.contactEmail}?subject=9line%20trust%20center%20access`}>{pub.securityContact.contactEmail}</a>
          from your government address with your agency and role.
        </p>
        <button class="btn btn-ghost" type="button" disabled title="Sign-in opens when the trust center service is live">Sign in (opening soon)</button>
      </div>
    </div>
  </section>

  <section id="data" class="section--tight">
    <div class="container">
      <h2 class="h2">Machine-readable data</h2>
      <p class="muted narrow">Everything on this page, as published files. The JSON and Markdown are generated together from one source.</p>
      <table class="dl">
        <thead><tr><th>Document</th><th>Rule</th><th>JSON</th><th>Markdown</th></tr></thead>
        <tbody>
          {files.map((f) => (
            <tr>
              <td>{f.name}</td>
              <td class="mono">{f.rule}</td>
              <td><a href={`/trust/nineline/${f.json}`}>{f.json}</a></td>
              <td>{f.md ? <a href={`/trust/nineline/${f.md}`}>{f.md}</a> : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .trust-h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 14px 0 18px; }
  .notice { margin-top: 26px; padding: 16px 18px; border: 1px solid var(--rule-strong); border-left: 3px solid var(--sunset);
    border-radius: var(--radius-sm); background: var(--surface); color: var(--text-dim); max-width: 72ch; }
  .notice strong { color: var(--text); display: block; margin-bottom: 4px; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .narrow { max-width: 70ch; margin: 12px 0 24px; }
  .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin: 24px 0 0;
    background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-sm); overflow: hidden; }
  .facts div { padding: 14px 16px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin: 0 -1px -1px 0; }
  .facts dt { color: var(--text-faint); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
  .facts dd { margin: 4px 0 0; color: var(--text); overflow-wrap: anywhere; }
  .totals { margin: 8px 0 28px; }
  .bar { display: flex; height: 12px; border-radius: 99px; overflow: hidden; background: var(--surface-2); }
  .seg { display: block; height: 100%; }
  .seg.ok, .dot.ok { background: var(--seafoam); }
  .seg.part, .dot.part { background: var(--sunset); }
  .seg.none, .dot.none { background: var(--surface-3); border: 1px solid var(--rule-strong); }
  .legend { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 14px; color: var(--text-dim); }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; vertical-align: 0; }
  .themes { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 18px; }
  .theme { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); padding: 16px; }
  .theme-h { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .theme-h b { flex: 1; font-family: var(--font-display); font-weight: 600; }
  .abbr { font-family: var(--font-mono); font-size: 12px; color: var(--sunset); border: 1px solid var(--rule-strong); border-radius: 6px; padding: 2px 6px; }
  .n { font-family: var(--font-mono); font-size: 12px; color: var(--text-faint); }
  .ksi { border-top: 1px solid var(--rule); }
  .ksi summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 10px 2px; align-items: center; }
  .ksi summary::-webkit-details-marker { display: none; }
  .ksi summary:hover .kname { color: var(--sunset); }
  .ksi summary:focus-visible { outline: 2px solid var(--sunset); outline-offset: 2px; border-radius: 6px; }
  .kname { color: var(--text); font-size: 15px; }
  .kid { grid-column: 1; font-family: var(--font-mono); font-size: 12px; color: var(--text-faint); }
  .ksi .pill { grid-column: 2; grid-row: 1 / span 2; }
  .pill { font-size: 11px; font-weight: 600; letter-spacing: 0.02em; padding: 3px 8px; border-radius: 99px; white-space: nowrap; }
  .pill.ok { background: color-mix(in srgb, var(--seafoam) 18%, transparent); color: var(--seafoam); }
  .pill.part { background: color-mix(in srgb, var(--sunset) 18%, transparent); color: var(--sunset); }
  .pill.none { background: var(--surface-3); color: var(--text-dim); }
  .kbody { padding: 4px 2px 14px; }
  .stmt { color: var(--text-dim); font-size: 14px; margin: 0 0 12px; }
  .kfacts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; margin: 0; font-size: 13px; }
  .kfacts .wide { grid-column: 1 / -1; }
  .kfacts dt { color: var(--text-faint); font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; }
  .kfacts dd { margin: 2px 0 0; color: var(--text); }
  .mono { font-family: var(--font-mono); font-size: 12px; }
  .src { color: var(--text-faint); font-size: 13px; margin-top: 18px; }
  .rules { grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); }
  .stmt-list { margin: 0 0 10px; padding-left: 1.2em; color: var(--text-dim); font-size: 13px; display: grid; gap: 4px; }
  .matrix td, .matrix th { text-align: right; }
  .matrix td:first-child, .matrix th:first-child { text-align: left; }
  .matrix .total td { color: var(--text); font-weight: 600; border-top: 1px solid var(--rule-strong); }
  .pending p { margin: 0 0 12px; color: var(--text-dim); }
  .pending strong { color: var(--text); }
  .types { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .types li { font-size: 13px; color: var(--text-dim); border: 1px solid var(--rule-strong); border-radius: 99px; padding: 3px 10px; }
  .milestones { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; background: var(--rule);
    border: 1px solid var(--rule); border-radius: var(--radius-sm); overflow: hidden; }
  .milestones li { background: var(--surface); padding: 16px; display: grid; grid-template-columns: 110px 1fr; gap: 14px; align-items: start; }
  .milestones .pill { justify-self: start; }
  .milestones b { color: var(--text); }
  .milestones p { margin: 4px 0 0; font-size: 14px; }
  .when { color: var(--text-faint); font-family: var(--font-mono); font-size: 12px !important; }
  .pkg p { margin: 0 0 14px; color: var(--text-dim); max-width: 72ch; }
  .pkg a { color: var(--sunset); }
  .pkg button[disabled] { opacity: 0.55; cursor: not-allowed; }
  .dl { width: 100%; border-collapse: collapse; font-size: 14px; }
  .dl th, .dl td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--rule); }
  .dl th { color: var(--text-faint); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.07em; }
  .dl a { color: var(--sunset); }
  @media (max-width: 560px) {
    .themes, .rules { grid-template-columns: 1fr; }
    .kfacts { grid-template-columns: 1fr; }
    .milestones li { grid-template-columns: 1fr; gap: 8px; }
    .dl { font-size: 13px; }
    .dl th:nth-child(2), .dl td:nth-child(2) { display: none; }
  }
</style>
