---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import { FERMENTED_OPINIONS_PODCAST, FERMENTED_OPINIONS } from "../../data/company.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

// Blog node with the posts enumerated — lets a crawler take the whole index in
// one pass instead of discovering posts link by link.
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Optimal — Field notes",
  description:
    "Notes on GCC High, CMMC readiness, and AI security from Optimal — threat models, defenses, and secure engineering for the defense industrial base.",
  url: "https://gooptimal.io/blog",
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: "Optimal", url: "https://gooptimal.io" },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    description: p.data.description,
    datePublished: new Date(p.data.date).toISOString(),
    url: `https://gooptimal.io/blog/${p.id}`,
  })),
};
---

<Layout
  title="Field notes — GCC High, CMMC & AI security | Optimal"
  description="Notes on GCC High, CMMC readiness, and AI security from Optimal — threat models, defenses, and secure engineering for the defense industrial base and the teams adopting frontier AI."
  breadcrumbs={[{ name: "Home", href: "/" }]}
  jsonLd={[blogSchema]}
>
  <Header />

  <section class="section relative">
    <div class="glow"></div>
    <div class="container z">
      <span class="eyebrow">Field notes</span>
      <h1 class="h2">Notes on securing AI in hard environments.</h1>
      <p class="lead" style="margin-top:14px;">
        AI security, guardrails, and what it takes to run frontier models where the rules are strict.
      </p>

      <div class="grid grid-3 posts">
        {posts.map((p) => (
          <a class="card post" href={`/blog/${p.id}`}>
            {p.data.image && (
              <div class="thumb">
                <img src={p.data.image} alt={p.data.imageAlt ?? p.data.title} loading="lazy" />
              </div>
            )}
            <span class="tag cat">{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <p class="muted excerpt">{p.data.description}</p>
            <time class="date" datetime={new Date(p.data.date).toISOString()}>{fmt(p.data.date)}</time>
          </a>
        ))}
      </div>

      <!-- The podcast lives on Substack; this is its on-site home. -->
      <aside class="card podcast">
        <div class="pod-copy">
          <span class="eyebrow">The podcast</span>
          <h2 class="pod-h">Fermented Opinions</h2>
          <p class="muted pod-sub">
            The technology behind national security, and the people betting the
            mission on it. Conversations from the same trenches these notes come from.
          </p>
        </div>
        <div class="pod-ctas">
          <a class="btn btn-primary" href={FERMENTED_OPINIONS_PODCAST}>Listen to the podcast →</a>
          <a class="btn btn-ghost" href={FERMENTED_OPINIONS}>Read the newsletter</a>
        </div>
      </aside>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .posts { margin-top: 42px; }
  .post { display: flex; flex-direction: column; gap: 12px; text-decoration: none; overflow: hidden; }
  .post .thumb {
    margin: -28px -28px 4px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid var(--rule);
  }
  .post .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .post:hover .thumb img { transform: scale(1.04); }
  .post .cat { align-self: flex-start; color: var(--sunset); border-color: color-mix(in srgb, var(--sunset) 35%, transparent); }
  .post h3 { font-size: 1.2rem; line-height: 1.25; }
  .post .excerpt { font-size: 14px; line-height: 1.6; flex: 1; }
  .post .date { font-size: 12px; color: var(--text-faint); font-family: var(--font-display); }
  .podcast { margin-top: 42px; display: grid; gap: 24px; align-items: center; }
  .pod-h { font-size: 1.5rem; margin-top: 10px; }
  .pod-sub { margin-top: 10px; font-size: 14.5px; line-height: 1.65; max-width: 56ch; }
  .pod-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 820px) { .podcast { grid-template-columns: 1fr auto; } }
</style>
