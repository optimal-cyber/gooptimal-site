---
// Primary navigation. "Solutions" collapses the offer destinations — managed
// GCC High, the AI security services, and the SLED practice — into one
// top-level item. Keeping "Services" as a sibling of "Solutions" would have
// read as two labels for the same thing, so it moves inside too.
//
// NINELINE is deliberately absent: it is a reference implementation we deploy
// inside an engagement, not a third thing we sell. Top-level billing framed it
// as a peer of the two pillars and contradicted the advisory-led positioning.
// It is reached from the AI services section, the GCC High page, and the footer.
const links = [
  {
    label: "Solutions",
    children: [
      {
        href: "/gcc-high",
        label: "Managed GCC High",
        desc: "CMMC-ready Microsoft 365 enclaves for the defense industrial base",
      },
      {
        href: "/#services",
        label: "AI security services",
        desc: "Assess, red-team, engineer, and advise",
      },
      {
        href: "/sled",
        label: "State, local & education",
        desc: "Governed AI and cloud security in the cloud you already license",
      },
    ],
  },
  { href: "/#how", label: "Architecture" },
  { href: "/#work", label: "Use cases" },
  { href: "/team", label: "Team" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label="Optimal home">
      <img src="/optimal-horizon.svg" alt="" width="28" height="28" class="mark" aria-hidden="true" />
      <span class="wordmark">OPTIMAL</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) =>
        l.children ? (
          <div class="has-menu" data-has-menu>
            <button type="button" class="menu-trigger" aria-expanded="false" aria-haspopup="true" data-submenu-trigger>
              {l.label}
              <svg class="caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div class="dropdown">
              <ul>
                {l.children.map((c) => (
                  <li>
                    <a href={c.href}>
                      <span class="dd-label">{c.label}</span>
                      <span class="dd-desc">{c.desc}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a href={l.href}>{l.label}</a>
        )
      )}
    </nav>

    <div class="actions">
      <a
        href="https://github.com/optimal-cyber"
        class="gh"
        target="_blank"
        rel="noopener"
        aria-label="Optimal on GitHub — open-source reference architectures"
        title="Optimal on GitHub"
      >
        <svg width="19" height="19" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <a href="/contact" class="btn btn-primary">Book a scoping call</a>
    </div>

    <button
      type="button"
      class="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <!-- Mobile menu — hidden ≥900px, toggled by the hamburger below it -->
  <nav id="mobile-menu" class="mobile-menu" aria-label="Primary (mobile)" data-mobile-menu hidden>
    <ul>
      {links.map((l) =>
        l.children ? (
          <li class="group">
            <span class="group-label">{l.label}</span>
            <ul class="sub">
              {l.children.map((c) => (
                <li><a href={c.href} data-menu-link>{c.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={l.href} data-menu-link>{l.label}</a></li>
        )
      )}
    </ul>
    <a href="/contact" class="btn btn-primary mobile-cta" data-menu-link>Book a scoping call →</a>
    <a
      href="https://github.com/optimal-cyber"
      class="gh gh-mobile"
      target="_blank"
      rel="noopener"
      data-menu-link
    >
      <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
      </svg>
      <span>Optimal on GitHub ↗</span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(12px);
    background: rgba(8, 9, 13, 0.72);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand .mark { width: 28px; height: 28px; border-radius: 50%; display: block; }
  .wordmark {
    font-family: var(--font-display); font-weight: 600; letter-spacing: 0.22em;
    font-size: 15px; color: var(--text);
  }
  /* Nav stretches the full bar height so the dropdown's `top: 100%` lands
     exactly on the header's bottom border — and so there's no dead gap for the
     pointer to fall through between trigger and panel. */
  .nav { display: none; gap: 30px; align-self: stretch; align-items: stretch; }
  .nav > a {
    display: inline-flex; align-items: center;
    font-size: 14px; color: var(--text-dim); transition: color .2s ease;
  }
  .nav > a:hover { color: var(--text); }
  .actions { display: none; align-items: center; gap: 18px; }

  /* GitHub mark — quiet until hovered, like the rest of the nav */
  .gh {
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--text-dim); transition: color .2s ease, transform .2s ease;
  }
  .gh:hover { color: var(--text); transform: translateY(-1px); }
  .gh svg { display: block; }
  .gh-mobile {
    gap: 10px; justify-content: center; margin-top: 16px;
    font-size: 14px; color: var(--text-dim);
  }
  .gh-mobile:hover { transform: none; color: var(--sunset); }

  /* Solutions dropdown — opens on hover and on keyboard focus. Pure CSS, so it
     still works if the sync script below never runs. */
  .has-menu { position: relative; display: flex; align-items: stretch; }
  .menu-trigger {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-body); font-size: 14px; color: var(--text-dim);
    background: transparent; border: 0; padding: 0; cursor: pointer;
    transition: color .2s ease;
  }
  .has-menu:hover .menu-trigger,
  .has-menu:focus-within .menu-trigger { color: var(--text); }
  .caret { opacity: 0.7; transition: transform .2s ease; }
  .has-menu:hover .caret,
  .has-menu:focus-within .caret { transform: rotate(180deg); }

  .dropdown {
    position: absolute; top: 100%; left: -20px; min-width: 312px;
    background: rgba(8, 9, 13, 0.97);
    backdrop-filter: blur(12px);
    border: 1px solid var(--rule); border-radius: var(--radius-sm);
    box-shadow: var(--shadow); padding: 8px;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
  }
  .has-menu:hover .dropdown,
  .has-menu:focus-within .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .dropdown ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .dropdown a {
    display: grid; gap: 3px; padding: 11px 12px; border-radius: 8px;
    transition: background .18s ease;
  }
  .dropdown a:hover { background: var(--surface-2); }
  .dd-label { font-size: 14px; font-weight: 500; color: var(--text); }
  .dd-desc { font-size: 12.5px; line-height: 1.45; color: var(--text-faint); }

  /* Hamburger — mobile only */
  .menu-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; margin-right: -10px;
    background: transparent; border: 0; cursor: pointer; color: var(--text);
    -webkit-tap-highlight-color: transparent;
  }
  .bars { position: relative; width: 22px; height: 16px; display: block; }
  .bars span {
    position: absolute; left: 0; width: 100%; height: 2px; border-radius: 2px;
    background: currentColor; transition: transform .25s ease, opacity .2s ease, top .25s ease;
  }
  .bars span:nth-child(1) { top: 0; }
  .bars span:nth-child(2) { top: 7px; }
  .bars span:nth-child(3) { top: 14px; }
  .site-header[data-open] .bars span:nth-child(1) { top: 7px; transform: rotate(45deg); }
  .site-header[data-open] .bars span:nth-child(2) { opacity: 0; }
  .site-header[data-open] .bars span:nth-child(3) { top: 7px; transform: rotate(-45deg); }

  /* Mobile menu panel */
  .mobile-menu {
    position: absolute; top: 100%; left: 0; right: 0;
    background: rgba(8, 9, 13, 0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
    padding: 12px 24px 24px;
    box-shadow: var(--shadow);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu > ul { list-style: none; margin: 0 0 8px; padding: 0; display: grid; }
  .mobile-menu li { border-bottom: 1px solid var(--rule); }
  .mobile-menu li a {
    display: block; padding: 15px 4px; font-family: var(--font-display); font-weight: 500;
    font-size: 1.05rem; color: var(--text); transition: color .2s ease;
  }
  .mobile-menu li a:hover { color: var(--sunset); }

  /* Grouped section — flattened, since a nested accordion on a 5-item menu is
     more taps than it saves. */
  .mobile-menu .group { padding: 14px 0 6px; }
  .group-label {
    display: block; padding: 0 4px; margin-bottom: 4px;
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--text-faint);
  }
  .mobile-menu .sub { list-style: none; margin: 0; padding: 0; display: grid; }
  .mobile-menu .sub li { border-bottom: 0; }
  .mobile-menu .sub li a {
    padding: 11px 0 11px 14px; font-size: 1rem;
    border-left: 2px solid var(--rule); transition: color .2s ease, border-color .2s ease;
  }
  .mobile-menu .sub li a:hover { border-left-color: var(--sunset); }

  .mobile-cta { width: 100%; justify-content: center; margin-top: 18px; padding: 14px 22px; }

  @media (min-width: 900px) {
    .nav { display: flex; }
    .actions { display: flex; }
    .menu-toggle { display: none; }
    .mobile-menu { display: none !important; }
  }
</style>

<script is:inline>
  (() => {
    const header = document.querySelector("[data-header]");
    if (!header) return;
    const toggle = header.querySelector("[data-menu-toggle]");
    const menu = header.querySelector("[data-mobile-menu]");

    const setOpen = (open) => {
      if (!toggle || !menu) return;
      header.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
    };

    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      // Close after a link tap (anchors scroll within the same page)
      menu.querySelectorAll("[data-menu-link]").forEach((a) =>
        a.addEventListener("click", () => setOpen(false))
      );

      const mq = window.matchMedia("(min-width: 900px)");
      mq.addEventListener("change", (e) => { if (e.matches) setOpen(false); });
    }

    // Keep aria-expanded honest about the CSS-driven dropdown state, and let a
    // tap on the trigger close a submenu that focus already opened.
    header.querySelectorAll("[data-has-menu]").forEach((wrap) => {
      const trigger = wrap.querySelector("[data-submenu-trigger]");
      if (!trigger) return;

      const sync = () => {
        const open = wrap.matches(":hover") || wrap.contains(document.activeElement);
        trigger.setAttribute("aria-expanded", String(open));
      };
      ["mouseenter", "mouseleave", "focusin", "focusout"].forEach((ev) =>
        wrap.addEventListener(ev, () => requestAnimationFrame(sync))
      );

      trigger.addEventListener("click", () => {
        if (trigger.getAttribute("aria-expanded") === "true") trigger.blur();
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      setOpen(false);
      const active = document.activeElement;
      if (active instanceof HTMLElement && active.closest("[data-has-menu]")) active.blur();
    });
  })();
</script>
