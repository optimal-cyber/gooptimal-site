---
import "../styles/global.css";
import { CAGE, UEI, NAICS_CODES, pending } from "../data/company.ts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  /** "article" on blog posts — everything else stays "website". */
  type?: "website" | "article";
  /** ISO dates, article pages only. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Trail from the home page down to (but not including) the current page. */
  breadcrumbs?: { name: string; href: string }[];
  /** Extra JSON-LD blocks emitted after the site-wide graph. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title = "Optimal — Managed GCC High enclaves & governed AI for the defense industrial base",
  description = "Optimal builds, migrates, and manages CMMC-ready Microsoft 365 GCC High enclaves for the defense industrial base — and stands up the governed AI that runs safely inside them. Aligned to DFARS 252.204-7012, NIST SP 800-171, and CMMC Level 2, with support for CUI and ITAR-controlled data. An SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB).",
  image = "/optimal-social-preview.png",
  keywords = "GCC High, Microsoft 365 GCC High, managed GCC High, GCC High migration, GCC High MSP, CMMC, CMMC 2.0, CMMC Level 2, CMMC compliance, NIST SP 800-171, DFARS 252.204-7012, CUI, Controlled Unclassified Information, ITAR compliant cloud, defense industrial base, DIB, DoD contractor compliance, CUI enclave, SDVOSB, Service-Disabled Veteran-Owned Small Business, SBA VetCert, governed AI, secure AI gateway, AI guardrails, Zero Trust AI, GovCloud AI, air-gapped AI, AI red-teaming, NIST AI RMF, OWASP LLM Top 10, Azure OpenAI, Azure Government, Amazon Bedrock, Google Vertex AI, GCC High cost, GCC High pricing, External Service Provider, shared responsibility matrix, SLED AI security, public sector AI governance, capability statement, CAGE 14HQ0, UEI TYMSGKDF2K48",
  type = "website",
  publishedTime,
  modifiedTime,
  breadcrumbs = [],
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Crawler directives. `max-snippet:-1` and `max-image-preview:large` matter for
// answer engines specifically — the default snippet cap truncates the passages
// AI Overviews and LLM search indexes quote from.
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

// Breadcrumb item URLs have to match the canonical form exactly, or the two
// disagree about which URL the page lives at. Astro emits directory-style
// paths, so every non-root path gets a trailing slash.
const absolute = (href: string) => {
  const u = new URL(href, Astro.site);
  if (!u.hash && !u.pathname.endsWith("/")) u.pathname += "/";
  return u.href;
};

// BreadcrumbList — gives crawlers and answer engines the page's place in the
// site hierarchy. The current page is appended to whatever trail is passed in,
// with the " — Optimal" title suffix stripped: it belongs in a browser tab, not
// in a breadcrumb rendered under a search result.
const crumbSchema = breadcrumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        ...breadcrumbs,
        { name: title.replace(/\s*[—|]\s*Optimal\s*$/, "").trim(), href: Astro.url.pathname },
      ].map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: absolute(b.href),
      })),
    }
  : null;

// WebSite node — anchors every page to one site entity and declares the search
// endpoint. Without it, crawlers infer the site from page-level signals alone.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Optimal",
  alternateName: "Optimal, LLC",
  url: "https://gooptimal.io",
  publisher: { "@type": "Organization", name: "Optimal", url: "https://gooptimal.io" },
  inLanguage: "en-US",
};

// Site-wide Organization structured data — advertises the SDVOSB credential to
// Google, AI Overviews, and LLM crawlers as machine-readable fact, not just prose.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Optimal",
  legalName: "Optimal, LLC",
  url: "https://gooptimal.io",
  logo: "https://gooptimal.io/optimal-horizon-512.png",
  image: "https://gooptimal.io/optimal-social-preview.png",
  email: "ryan@gooptimal.io",
  slogan: "Sovereign by default.",
  founder: {
    "@type": "Person",
    name: "Ryan Gutwein",
    jobTitle: "Founder & Chief Executive Officer",
    url: "https://gooptimal.io/team",
  },
  // Entity reconciliation — these are the off-site records that let a search or
  // answer engine resolve "Optimal" to this company rather than the dictionary
  // word. The SBA registry is the authoritative one.
  sameAs: [
    "https://github.com/optimal-cyber",
    "https://search.certifications.sba.gov/",
    "https://fermentedopinions.substack.com/",
  ],
  // Federal registration identifiers. A GovCon buyer resolves a vendor by CAGE
  // and UEI, so they belong in the graph rather than only in footer text.
  identifier: [
    { "@type": "PropertyValue", propertyID: "CAGE", value: CAGE },
    { "@type": "PropertyValue", propertyID: "UEI", value: UEI },
  ],
  ...(pending(NAICS_CODES) ? {} : { naics: NAICS_CODES }),
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "sales",
      email: "ryan@gooptimal.io",
      url: "https://gooptimal.io/contact",
      areaServed: "US",
      availableLanguage: "English",
    },
  ],
  description:
    "Optimal builds, migrates, and manages CMMC-ready Microsoft 365 GCC High enclaves for the defense industrial base — aligned to DFARS 252.204-7012, NIST SP 800-171, and CMMC Level 2, with support for CUI and ITAR-controlled data — and stands up the governed access layer for frontier AI inside them (Azure OpenAI in Azure Government, Amazon Bedrock, Google Vertex AI, or self-hosted). We also assess and red-team AI systems and advise teams on adopting AI safely. An SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB).",
  areaServed: [
    "United States defense industrial base",
    "United States federal government",
    "State and local government",
    "Higher education",
    "Enterprise",
  ],
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Managed Microsoft 365 GCC High Enclave",
        description:
          "Design, build, migration, and ongoing management of a CMMC-ready Microsoft 365 GCC High environment for defense contractors handling CUI and ITAR-controlled data — aligned to DFARS 252.204-7012, NIST SP 800-171, and CMMC Level 2, including GCC High G5 licensing and provisioning.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "CMMC Readiness & NIST 800-171 Engineering",
        description:
          "Implementation of the NIST SP 800-171 control set inside a GCC High enclave, with System Security Plan (SSP) and POA&M support, evidence collection, and readiness for a third-party (C3PAO) CMMC Level 2 assessment. Optimal prepares the environment; the certified assessment is performed independently.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Governed AI Access for State, Local & Education",
        description:
          "Governed, audited access to frontier models inside the cloud a public-sector organization already licenses — Azure OpenAI Service, Amazon Bedrock, or Google Vertex AI — plus cloud security review, data-protection engineering for CJIS, HIPAA, PCI DSS, and FERPA data, and IT risk advisory.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "AI Security Assessment",
        description:
          "Structured evaluation of AI systems, pipelines, and integrations against real adversary attack paths, measured to the OWASP LLM Top 10, MITRE ATLAS, and NIST AI RMF.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Adversarial AI Testing",
        description:
          "Offensive red-team testing of AI-enabled systems — prompt injection, model manipulation, data extraction, and abuse-case simulation.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Governed AI Engineering",
        description:
          "Design and stand-up of a Zero Trust access layer for AI — authenticated gateway, prompt guardrails, default-deny egress, and an auditable trail — in the client's environment.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Secure AI Adoption Advisory",
        description:
          "Practical, engineering-grounded usage patterns, threat models, and secure-adoption roadmaps scoped to an organization's risk profile.",
      },
    },
  ],
  knowsAbout: [
    "Microsoft 365 GCC High",
    "GCC High migration",
    "CMMC",
    "CMMC Level 2",
    "NIST SP 800-171",
    "DFARS 252.204-7012",
    "Controlled Unclassified Information (CUI)",
    "ITAR compliance",
    "Defense industrial base",
    "Azure Government",
    "Governed AI",
    "Secure AI gateway",
    "AI guardrails",
    "Zero Trust architecture",
    "AI red-teaming",
    "NIST AI RMF",
    "Frontier model access",
    "Azure OpenAI Service",
    "Amazon Bedrock",
    "Google Vertex AI",
    "Service-Disabled Veteran-Owned Small Business",
    "External Service Provider (ESP) shared responsibility",
    "CJIS",
    "HIPAA",
    "FERPA",
    "State, local and education (SLED) technology",
  ],
  hasCredential: [
    {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "certification",
      name: "Service-Disabled Veteran-Owned Small Business (SDVOSB)",
      description:
        "SBA-certified Service-Disabled Veteran-Owned Small Business and Veteran-Owned Small Business via the SBA Veteran Small Business Certification (VetCert) program. Eligible for SDVOSB and VOSB set-aside contracts.",
      url: "https://search.certifications.sba.gov/",
      recognizedBy: {
        "@type": "GovernmentOrganization",
        name: "U.S. Small Business Administration",
        url: "https://www.sba.gov",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Optimal, LLC" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Optimal" />
    <meta property="og:locale" content="en_US" />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <!-- Plain-language site summary for LLM crawlers and agents -->
    <link rel="alternate" type="text/plain" href="https://gooptimal.io/llms.txt" title="llms.txt" />
    <link rel="icon" type="image/svg+xml" href="/optimal-horizon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/optimal-horizon-32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    {crumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} is:inline />
    )}
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
    ))}
  </head>
  <body>
    <slot />
    <!-- Secure Gateway Constellation — inits only on pages with a [data-gateway-3d] canvas -->
    <script is:inline defer src="/js/gateway-3d.js"></script>
  </body>
</html>
